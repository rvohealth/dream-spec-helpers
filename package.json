{
  "type": "module",
  "name": "@rvoh/dream-spec-helpers",
  "version": "2.4.0",
  "description": "dream orm spec helpers",
  "engines": {
    "node": ">=24"
  },
  "author": "RVO Health",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvohealth/dream-spec-helpers.git"
  },
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "files": [
    "tsconfig.json",
    "src/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "build": "echo \"building dream-spec-helpers...\" && rm -rf dist && tsc -p ./tsconfig.cjs.build.json && tsc -p ./tsconfig.esm.build.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "format": "pnpm prettier . --write",
    "prepack": "pnpm build",
    "lint": "pnpm eslint --no-warn-ignored \"src/**/*.ts\" \"spec/**/*.ts\" && pnpm prettier . --check",
    "spec": "vitest run"
  },
  "peerDependencies": {
    "@types/node": "*",
    "@types/pg": "*",
    "pg": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.11.8",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "pg": "^8.12.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "pluralize-esm": "^9.0.5"
  }
}
